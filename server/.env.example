# Environment Variables for Portfolio Backend

# =====================
# SERVER
# =====================
PORT=5000
NODE_ENV=development

# =====================
# DATABASE
# =====================
# MongoDB connection string (Atlas or local)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/portfolio?retryWrites=true&w=majority

# =====================
# JWT AUTH
# =====================
# Secret key for signing access tokens (min 32 chars recommended)
JWT_SECRET=your_super_secret_jwt_key_here_make_it_long_and_random

# Secret key for signing refresh tokens
JWT_REFRESH_SECRET=your_super_secret_refresh_key_here_make_it_long_and_random

# Access token expiry (e.g., 15m, 1h)
JWT_EXPIRES_IN=15m

# Refresh token expiry (e.g., 7d, 30d)
JWT_REFRESH_EXPIRES_IN=7d

# =====================
# CLOUDINARY (Image Hosting)
# =====================
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# =====================
# CORS
# =====================
# Allowed frontend origin(s), comma-separated for multiple
FRONTEND_URL=http://localhost:3000

# =====================
# ADMIN SEED CREDENTIALS
# =====================
# These are used only on first startup to seed the admin user
ADMIN_EMAIL=shukanp0509@gmail.com
ADMIN_PASSWORD=Shukan4978

# =====================
# RATE LIMITING
# =====================
# Optional overrides (defaults are in rateLimiter.ts)
# GENERAL_RATE_LIMIT=200
# AUTH_RATE_LIMIT=5
# CONTACT_RATE_LIMIT=10
